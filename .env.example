# AI Configuration
VZCODE_EDIT_WITH_AI_API_KEY=your_openrouter_api_key_here
VZCODE_EDIT_WITH_AI_MODEL_NAME=qwen/qwen3-coder

# Optional: enable LiveKit voice chat
VITE_ENABLE_LIVEKIT=false
VITE_LIVEKIT_URL=https://your-livekit-server.example
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional: enable speech-to-text in AI chat
VITE_ENABLE_VOICE_INPUT=false

# Optional: Editor port (defaults to 3030)
EDITOR_PORT=3030
